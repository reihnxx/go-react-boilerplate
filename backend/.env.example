# Copy to .env (git-ignored). Real environments should inject these variables
# instead of using a file. Never commit real credentials.

# development | test | production
APP_ENV=development
APP_NAME=Admin Panel
HTTP_ADDR=:8080
# Public URL of the SPA (used in password-reset links).
APP_BASE_URL=http://localhost:5173
# Comma-separated origins allowed to send state-changing requests.
APP_ALLOWED_ORIGINS=http://localhost:5173
# Trust X-Forwarded-For / X-Real-IP (only behind your own reverse proxy).
TRUST_PROXY=false

# PostgreSQL DSN (pgx). Local example (DBngin / Postgres.app, no password):
DATABASE_URL=postgres://postgres@127.0.0.1:5432/go_boilerplate?sslmode=disable
DB_MAX_CONNS=10
MIGRATE_ON_START=false

# Sessions: sliding idle timeout and absolute lifetime.
SESSION_IDLE_TIMEOUT=120m
SESSION_MAX_LIFETIME=168h
# Defaults to true when APP_ENV=production. Requires HTTPS.
# COOKIE_SECURE=false

# Login throttle: failures allowed per (login, IP) before a lockout of AUTH_LOCKOUT.
AUTH_MAX_ATTEMPTS=5
# Failed logins allowed per IP across all usernames (password spraying).
AUTH_IP_MAX_ATTEMPTS=20
AUTH_LOCKOUT=60s

# Public self-registration (disabled by default). New users get AUTH_DEFAULT_ROLE.
AUTH_REGISTRATION_ENABLED=false
AUTH_DEFAULT_ROLE=user

REQUEST_TIMEOUT=30s
# debug | info | warn | error
LOG_LEVEL=info
# text | json (defaults to json in production)
# LOG_FORMAT=text

# log = print emails to the log (development only); smtp = send for real.
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Only read by CLI commands:
# ADMIN_PASSWORD=   password for `api create-admin` (otherwise prompted)
# SEED_PASSWORD=    password for `api seed` users (otherwise generated and printed)
