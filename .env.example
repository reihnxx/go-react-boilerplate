# Docker Compose settings. Copy to .env (git-ignored) and fill in real values.
# For running the API outside Docker, use backend/.env instead.

# --- required ---
# Used inside a connection URL: stick to letters, digits, "-" and "_".
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- database ---
POSTGRES_USER=app
POSTGRES_DB=boilerplate
# Host port for local DB tools (bound to 127.0.0.1 only).
DB_HOST_PORT=5433

# --- web ---
WEB_PORT=8080
APP_NAME=Admin Panel
# Must match the URL users open in the browser.
APP_BASE_URL=http://localhost:8080
APP_ALLOWED_ORIGINS=http://localhost:8080

# --- security ---
# development | production. "production" requires HTTPS in front of the web
# container (secure cookies + HSTS); keep "development" for plain-HTTP local use.
APP_ENV=development
COOKIE_SECURE=false
AUTH_REGISTRATION_ENABLED=false

# --- mail (password reset) ---
# log = print emails to the API log (no delivery); smtp = real delivery.
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
