# Copy to .env (git-ignored). Values here are compiled into the public bundle,
# so never put secrets in them.
VITE_APP_NAME=Admin Panel
# API base path. Keep the SPA and API on the same origin (see ARCHITECTURE.md).
VITE_API_BASE=/api/v1
# Dev server only: where Vite proxies /api.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
